{
  "name": "assistant-agent",
  "version": "0.1.0",
  "description": "Gary's AI assistant Rachel — email, calendar, Slack, tasks, and wiki via the Claude Agent SDK.",
  "type": "module",
  "scripts": {
    "architecture-check": "tsx scripts/architecture-check.ts",
    "start": "tsx src/cli/main.ts",
    "bridge": "tsx src/telegram/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run architecture-check && node --experimental-strip-types --test 'src/**/*.test.ts' 'gate/**/*.test.ts' 'bridge/**/*.test.ts' 'proactive/**/*.test.ts' 'scripts/**/*.test.ts' && bash hooks/scripts/tests/probe_conventions.test.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@openai/codex-sdk": "^0.147.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
